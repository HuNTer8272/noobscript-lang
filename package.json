{
  "name": "noobscript-lang",
  "version": "1.0.0",
  "description": "NoobScript — a programming language with gaming slang syntax",
  "keywords": [
    "noobscript",
    "programming-language",
    "interpreter",
    "gaming"
  ],
  "author": "Hassaan Tole",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/HuNTer8272/noobscript-lang.git"
  },
  "bugs": {
    "url": "https://github.com/HuNTer8272/noobscript-lang/issues"
  },
  "homepage": "https://github.com/HuNTer8272/noobscript-lang#readme",
  "bin": {
    "noob": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/cli/main.js",
    "dev": "tsx src/cli/main.ts",
    "example": "tsx src/cli/main.ts examples/test.noob",
    "package:vscode": "cd noobscript-vscode && npx @vscode/vsce package",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
